# ARES 2.0 — copie para .env.local (dev) ou configure no serviço da LXC.
# Nunca commite valores reais.

# Postgres do 2.0 (LXC própria — NÃO o banco de produção do ARES 1)
DB_HOST=
DB_PORT=5432
DB_NAME=ares_bi
DB_USER=
DB_PASSWORD=

# Chave de assinatura da sessão (gere com: openssl rand -base64 48)
SESSION_SECRET=

# SHA-256 (hex) da senha inicial dos usuários
# (gere com: printf 'minha-senha' | sha256sum)
ARES_DEFAULT_PASSWORD_HASH=

# Opcional: monitoramento do Dokploy na tela System Health
DOKPLOY_URL=
DOKPLOY_API_KEY=
